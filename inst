#!/bin/bash
# Arch install script for UEFI in virtual hardware. 2026-11-08
# Note: Requires 20G minimum drive for install as currently configured. See: 'Partition variables' below.
# Suggest using an ssh connection for using this script: https://wiki.archlinux.org/title/Install_Arch_Linux_via_SSH#

set -euo pipefail
trap 'S="${?}"; if (( S != 0 )); then echo "${0} : Error on line ${LINENO} : ${BASH_COMMAND} : exit ${S}"; fi' ERR INT TERM

	## Prevent accidentally running on host system. ##

if 	[[ ! ${HOSTNAME} = archiso ]]; then
	echo "Exit install if not running on Arch ISO."
	exit
fi

Col_Ptr=$(echo -e "\033[1;96m:: Installer ==>\033[00m")
Col_Cancel=$(echo -e "\033[0m")
CacheServer="http://192.168.2.52:9129/repo/archlinux/\$repo/os/\$arch"

#==========# User, password, hostname, editor variables. #==========#

User_Name="jeff"
User_Password="test"
Root_Password="test"
HostName="Arch-2026p11"
Editor="nano"

#==========# Partition variables. #==========#

Part_Map_Spec="gpt"		## Partition map specification. ##
Install_Dev="/dev/sda"		## Installation device. ##

ESP_Part="/dev/sda1"		## ESP partition. ##
Root_Part="/dev/sda2"		## Root partition. ##
Swap_Part="/dev/sda3"		## Swap partition. ##
Home_Part="/dev/sda4"		## Home partition. ##

Root_Size="10"			## Root partition size in whole GB.
Swap_Size="3"			## Swap partition size in whole GB.
Home_Size="5"			## Home partition 'minimum' size in whole GB.
# Note: ESP partition size hard coded to 256M and only contains the Grub binary.

#==========# Unmount partitions #==========#

	umount "${Home_Part}"  2>/dev/null		|| /bin/true
	umount "${ESP_Part}"   2>/dev/null		|| /bin/true
	swapoff "${Swap_Part}" 2>/dev/null		|| /bin/true
	umount "${Root_Part}"  2>/dev/null		|| /bin/true

#==========# SETUP PARTITIONS AND MOUNTS #==========#

partition(){

	## Calculate and check if device size is large enough. ##

device_size=$(/usr/bin/lsblk -dn -b -o SIZE "${Install_Dev}" | awk '{print int($1 / 1000000000)}')
min_size=$(( Root_Size + Home_Size + Swap_Size + 1 ))

if	(( device_size < min_size )); then
	echo; echo "${Col_Ptr} Error: Installation device must be at least ${min_size} GB (found ${device_size} GB). ${Col_Cancel}"
	exit 1
fi
	echo; echo "${Col_Ptr} Installing Arch to ${Install_Dev}. ${Col_Cancel}"
	echo "${Col_Ptr} To exit press [Ctrl]+[C]. ${Col_Cancel}"
	sleep 4
	echo "${Col_Ptr} Cleaning up any existing mounts, swap, and partition signatures on ${Install_Dev}... ${Col_Cancel}"
	echo

	## Remove any existing filesystem signatures or superblocks. ##

	umount -R /mnt 2>/dev/null         || true
	swapoff "${Swap_Part}" 2>/dev/null || true
	wipefs -a -f "${Install_Dev}"

	## Convert fixed GB sizes to MiB offsets (1 GB = 1024 MiB) ##

	esp_end=256
	root_end=$(( esp_end + (Root_Size * 1024) ))
	swap_end=$(( root_end + (Swap_Size * 1024) ))

	parted -s "${Install_Dev}" mklabel "${Part_Map_Spec}"
	parted -s "${Install_Dev}" unit MiB mkpart ESP fat32 1 "${esp_end}"
	parted -s "${Install_Dev}" set 1 esp on
	parted -s "${Install_Dev}" unit MiB mkpart primary ext4 "${esp_end}" "${root_end}"
	parted -s "${Install_Dev}" unit MiB mkpart primary linux-swap "${root_end}" "${swap_end}"
	parted -s "${Install_Dev}" unit MiB mkpart primary ext4 "${swap_end}" 100%
}

formats(){

	mkfs.fat -F32 "${ESP_Part}"
	mkfs.ext4 -q "${Root_Part}"
	mkfs.ext4 -q "${Home_Part}"
	mkswap "${Swap_Part}"
}

mounts(){

	mount "${Root_Part}" /mnt
	mkdir -p /mnt/boot/efi /mnt/home
	mount "${ESP_Part}" /mnt/boot/efi
	mount "${Home_Part}" /mnt/home
	swapon "${Swap_Part}"

	echo; echo "${Col_Ptr} Finished mounts function.... ${Col_Cancel}"
	sleep 1
}
#==========# SETUP INSTALL ISO FOR RUNNING INSTALL SCRIPT #==========#

setrepos(){

	echo "${Col_Ptr} Adding pkgs to ISO needed for install script... ${Col_Cancel}"; echo
	sleep 3

	pacman -Syy
	pacman -S --noconfirm --needed nano wgetpaste moreutils reflector

	echo; echo "${Col_Ptr} Added local package server to top of ISO mirrorlist, below. ${Col_Cancel}"

if	! grep -q "${CacheServer}" /etc/pacman.d/mirrorlist; then
	sed -i "1s|^|${CacheServer}\n|" /etc/pacman.d/mirrorlist
fi
	echo "${Col_Ptr} -------------------- ${Col_Cancel}"; echo
	head /etc/pacman.d/mirrorlist
	echo; echo "${Col_Ptr} -------------------- ${Col_Cancel}"; echo
	sleep 3
}
#==========# INSTALL PACKAGES #==========#

install(){

	## BASE VBOX INSTALL. EDIT LIST FOR INSTALLED PACKAGES ##

	pacstrap    /mnt base linux
	arch-chroot /mnt pacman -S --noconfirm --needed grub efibootmgr wget nano openssh sudo terminus-font #\
						 	#xorg-server xorg-xinit xfce4 gvfs \
							#xterm ttf-dejavu ttf-liberation l3afpad \
							#virtualbox-guest-utils linux-headers
							#dhcpcd
}
#==========# CONFIGURE SYSTEM #==========#

configure_(){

	genfstab -L /mnt > /mnt/etc/fstab

	arch-chroot /mnt ln -sf /usr/share/zoneinfo/America/Los_Angeles		/etc/localtime
	arch-chroot /mnt hwclock --systohc

	echo "en_US.UTF-8 UTF-8" 						>> /mnt/etc/locale.gen

	arch-chroot /mnt locale-gen

	echo "LANG=en_US.UTF-8" 						>> /mnt/etc/locale.conf

	echo "KEYMAP=us"     							>> /mnt/etc/vconsole.conf
	echo "FONT=ter-120b" 							>> /mnt/etc/vconsole.conf

	echo "${HostName}" 							> /mnt/etc/hostname

	echo '127.0.0.1  localhost'                 				>> /mnt/etc/hosts
	echo '::1        localhost'                 				>> /mnt/etc/hosts
	echo "127.0.1.1	 ${HostName}.localdomain ${HostName}" 			>> /mnt/etc/hosts

#	arch-chroot /mnt systemctl enable dhcpcd

	arch-chroot /mnt grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=GRUB --removable --recheck
	arch-chroot /mnt grub-mkconfig -o 					/boot/grub/grub.cfg

	arch-chroot /mnt useradd -m -G wheel -s 				/bin/bash "${User_Name}"

	echo "${User_Name}:${User_Password}" | arch-chroot /mnt /usr/sbin/chpasswd	|| { echo "set password error" ; exit 1 ; }
	echo         "root:${Root_Password}" | arch-chroot /mnt /usr/sbin/chpasswd	|| { echo "set password error" ; exit 2 ; }

	arch-chroot /mnt systemctl enable systemd-timesyncd.service

	sed -i '/%wheel ALL=(ALL:ALL) ALL/s/^#//'				/mnt/etc/sudoers

	touch /mnt/etc/systemd/network/20-wired.network

	cat <<- EOF 								> /mnt/etc/systemd/network/20-wired.network
	[Match]
	Name=en*
	Name=eth*

	[Network]
	DHCP=yes
EOF
	arch-chroot /mnt systemctl enable systemd-networkd
	arch-chroot /mnt systemctl enable systemd-resolved
	arch-chroot /mnt systemctl enable sshd

	echo "nameserver 208.67.222.222 " 					>>/mnt/etc/resolv.conf
	echo "nameserver 208.67.222.220 " 					>>/mnt/etc/resolv.conf

	# Following prints local ip address above login prompt. Great for ssh sessions. #

	echo ' \4' 								>> /mnt/etc/issue

	#### if statement to check if Xorg is installed for setup. (WITH Xorg) ####

if	[[ -e /mnt/etc/X11/xinit/xinitrc ]]; then

	cp /mnt/etc/X11/xinit/xinitrc						/mnt/home/"${User_Name}"/.xinitrc
	sed -i '/twm/s/^/#/g'							/mnt/home/"${User_Name}"/.xinitrc
	sed -i '/xclock/s/^/#/g'      						/mnt/home/"${User_Name}"/.xinitrc
	sed -i '/xterm/s/^/#/g'       						/mnt/home/"${User_Name}"/.xinitrc
	echo 'exec startxfce4' >>     						/mnt/home/"${User_Name}"/.xinitrc
	arch-chroot /mnt chown "${User_Name}"					/home/"${User_Name}"/.xinitrc

	cp /mnt/etc/X11/xinit/xserverrc						/mnt/home/"${User_Name}"/.xserverrc
	sed -i '/exec/s/^/#/g'							/mnt/home/"${User_Name}"/.xserverrc
	echo 'exec /usr/bin/Xorg -keeptty -nolisten tcp "$@" vt"$XDG_VTNR"' >>  /mnt/home/"${User_Name}"/.xserverrc
	arch-chroot /mnt chown "${User_Name}"					/home/"${User_Name}"/.xserverrc
	arch-chroot /mnt systemctl enable vboxservice.service

    else

	#### Setup a service file to enlarge the vconsole resolution. (WITHOUT Xorg) ####

	touch /mnt/etc/systemd/system/display.service

	cat <<- EOF 								> /mnt/etc/systemd/system/display.service
	[Unit]
	Description=Display resolution
	After=local-fs.target
	DefaultDependencies=no

	[Service]
	Type=simple
	ExecStart=/usr/bin/fbset -xres 1730 -yres 970

	[Install]
	WantedBy=multi-user.target

EOF
	arch-chroot /mnt systemctl enable display.service

	echo ; echo "${Col_Ptr} This is a base install without xorg-server or wayland. ${Col_Cancel}" ; echo
	sleep 3
fi
}

mesg(){
	echo "${Col_Ptr}  The install is done except verifying and/or editing config files. ${Col_Cancel}"
	echo "${Col_Ptr}  Select yes to review and/or edit config files. ${Col_Cancel}"
	echo "${Col_Ptr}  Select no to exit, completing the install. ${Col_Cancel}"
}
#==========# STEP THROUGH CONFIG CHECKS #==========#

asksure(){
		echo -n " Proceed ? (Y/N)"
		while read -r -n 1 -s answer
		do
			if [[ $answer = [YyNn] ]] ; then
			   [[ $answer = [Yy] ]] && echo " Answered Yes " && XX=0 && break
			   [[ $answer = [Nn] ]] && echo " Answered No  " && XX=1 && break
			fi
		done
	reset >/dev/tty 2>&1
}
#==========# CHECK/EDIT CONFIG FILES #==========#

check_config() {

local filepath="${1}"
local desc="${2}"

if	[[ -e "$filepath" ]]; then
	clear >/dev/tty
	echo; echo " Checking ${desc} in ${Editor}"
	echo " Select yes to review/edit."
	echo " Select no to skip forward to next file."
	asksure

       	if	[[ $XX = 0 ]]; then
		cat "${filepath}" | EDITOR="${Editor}" vipe | awk '{print}' >tmp && mv tmp "${filepath}"
      		reset >/dev/tty 2>&1
	fi
fi
}
#==========# UNMOUNT PARTITIONS  #==========#

umnts(){

	umount "${ESP_Part}"		&& echo "${Col_Ptr} Unmount ESP ${Col_Cancel}"
	umount "${Home_Part}"		&& echo "${Col_Ptr} Unmount Home ${Col_Cancel}"
	swapoff "${Swap_Part}"		&& echo "${Col_Ptr} Swapoff ${Col_Cancel}"
	umount "${Root_Part}"		&& echo "${Col_Ptr} Unmount Root ${Col_Cancel}"
}

mesg2(){
	echo; echo "${Col_Ptr} Installation has completed. ${Col_Cancel}"
	echo "${Col_Ptr} Set root: password to \"${Root_Password}\" ${Col_Cancel}"
	echo "${Col_Ptr} Set user: \"${User_Name}\" password to \"${User_Password}\" ${Col_Cancel}"
	echo "${Col_Ptr} Install log has been copied to new install: /home/${User_Name}/install.log ${Col_Cancel}"
	echo "${Col_Ptr} To review the entire install process run: cat inst.log ${Col_Cancel}"; echo
}
#==========# Run Functions #==========#

## Group bracket below for logging ##
{
	partition
	formats
	mounts
	setrepos
	install
	configure_
	mesg
	asksure
if	[[ $XX = 0 ]]; then
	check_config "/mnt/home/${User_Name}/.xinitrc"		"${HOME}/.xinitrc"
	check_config "/mnt/home/${User_Name}/.xserverrc"	"${HOME}/.xserverrc"
	check_config "/mnt/etc/hosts"				"/etc/hosts"
	check_config "/mnt/etc/sudoers"				"/etc/sudoers"
	check_config "/mnt/etc/locale.gen"			"/etc/locale.gen"
	check_config "/mnt/etc/vconsole.conf"			"/etc/vconsole.conf"
	check_config "/mnt/etc/locale.conf"			"/etc/locale.conf"
fi
	cp inst.log /mnt/home/"${User_Name}"/install.log
	umnts
	mesg2
} |& tee inst.log
